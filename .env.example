# master-mcp configuration
#
# Every service below supports two shapes:
#
#   1) Single instance (shorthand) - just set the fields directly:
#        CLOUDFLARE_API_TOKEN=xxxx
#
#   2) Multiple named instances (different target/credentials per instance, e.g. two
#      Docker hosts or two Proxmox nodes) - list instance ids, then prefix each field
#      with the instance id:
#        DOCKER_INSTANCES=home,nas
#        DOCKER_HOME_SOCKET_PATH=/var/run/docker.sock
#        DOCKER_NAS_HOST=10.0.0.20
#        DOCKER_NAS_PORT=2375
#
# Uncomment/fill in only the services you actually use. Unconfigured services are
# simply hidden from list_services / list_actions - no error, no crash.

# ---- Cloudflare -------------------------------------------------------------
# API Token with the zone permissions you need (DNS, cache, firewall, etc), NOT
# the legacy Global API Key.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ---- Porkbun -----------------------------------------------------------------
# API key pair created at porkbun.com/account/api
# PORKBUN_API_KEY=
# PORKBUN_SECRET_API_KEY=

# ---- Docker --------------------------------------------------------------
# EITHER a local socket:
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# OR a remote TCP daemon (optionally with mutual TLS - CA/CERT/KEY as raw PEM content):
# DOCKER_HOST=10.0.0.20
# DOCKER_PORT=2375
# DOCKER_TLS=false
# DOCKER_TLS_CA=
# DOCKER_TLS_CERT=
# DOCKER_TLS_KEY=

# ---- Proxmox VE ------------------------------------------------------------
# API token created under Datacenter -> Permissions -> API Tokens.
# PROXMOX_BASE_URL=https://10.0.0.5:8006
# PROXMOX_TOKEN_ID=root@pam!mcp
# PROXMOX_TOKEN_SECRET=
# PROXMOX_INSECURE_TLS=true

# ---- Nginx Proxy Manager / NPMPlus -----------------------------------------
# Same REST API on both - identity/secret are your NPM login email/password.
# NPM_BASE_URL=http://10.0.0.5:81
# NPM_IDENTITY=
# NPM_SECRET=
# NPM_INSECURE_TLS=false

# ---- Uptime Kuma -------------------------------------------------------------
# Management is Socket.IO-only (no write REST API). 2FA-enabled accounts are not
# supported by this integration.
# UPTIME_KUMA_BASE_URL=http://10.0.0.5:3001
# UPTIME_KUMA_USERNAME=
# UPTIME_KUMA_PASSWORD=

# ---- Authentik ---------------------------------------------------------------
# Static API Token created under Admin Interface -> Directory -> Tokens.
# AUTHENTIK_BASE_URL=https://auth.example.com
# AUTHENTIK_API_TOKEN=
# AUTHENTIK_INSECURE_TLS=false

# ---- Multi-instance example (mix and match per service as needed) ----------
# PROXMOX_INSTANCES=home,office
# PROXMOX_HOME_BASE_URL=https://10.0.0.5:8006
# PROXMOX_HOME_TOKEN_ID=root@pam!mcp
# PROXMOX_HOME_TOKEN_SECRET=
# PROXMOX_OFFICE_BASE_URL=https://192.168.1.9:8006
# PROXMOX_OFFICE_TOKEN_ID=root@pam!mcp
# PROXMOX_OFFICE_TOKEN_SECRET=
